{
  "name": "zamorozka",
  "version": "0.1.0",
  "private": true,
  "description": "«Заморозка» — PWA-магазин замороженных полуфабрикатов: Vendure + Next.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "docker compose up",
    "dev:api": "npm run dev --workspace=@zamorozka/api",
    "dev:web": "npm run dev --workspace=@zamorozka/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "allowScripts": {
    "@apollo/protobufjs@1.2.8": true,
    "bcrypt@6.0.0": true,
    "sharp@0.34.5": true
  }
}
