{
  "compilerOptions": {
    "target": "es2022",
    // Обязательно для сущностей TypeORM: при `true` (умолчание для es2022)
    // поля класса объявляются через defineProperty уже после конструктора
    // базового класса и затирают присвоенные им значения — сущность
    // сохраняется с пустыми колонками.
    "useDefineForClassFields": false,
    "module": "commonjs",
    "lib": ["es2022", "esnext.asynciterable"],
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
