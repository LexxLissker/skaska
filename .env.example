# Скопируй в .env и поправь под себя: cp .env.example .env
# Файл .env в git не попадает.

# ─── Общее ────────────────────────────────────────────────────────────────────
APP_ENV=dev

# ─── База данных ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zamorozka
DB_USERNAME=vendure
DB_PASSWORD=vendure
DB_SCHEMA=public

# ─── Vendure API ──────────────────────────────────────────────────────────────
PORT=3000
# Учётка администратора создаётся при первом запуске. В проде — обязательно сменить.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
# Секрет подписи cookie. В проде — длинная случайная строка.
COOKIE_SECRET=zamorozka-dev-cookie-secret

# Откуда разрешены запросы к Shop API (через запятую)
CORS_ORIGIN=http://localhost:3001
STOREFRONT_URL=http://localhost:3001

# ─── Витрина Next.js ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SHOP_API_URL=http://localhost:3000/shop-api
# Адрес API изнутри docker-сети — используется при серверном рендеринге
SHOP_API_URL_INTERNAL=http://api:3000/shop-api
WEB_PORT=3001
