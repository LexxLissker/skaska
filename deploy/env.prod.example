# Образец /opt/zamorozka/.env на сервере.
# Скопируйте, заполните и держите с правами 600 — в git он не попадает.
#
# Пароли и секреты генерируйте, а не придумывайте:
#   openssl rand -base64 32

# Домен магазина. На него Caddy выпустит сертификат.
DOMAIN=zamorozka.example.ru

# ─── База данных ──────────────────────────────────────────────────────────────
DB_NAME=zamorozka
DB_USERNAME=vendure
DB_PASSWORD=ЗАМЕНИТЕ

# ─── Vendure ──────────────────────────────────────────────────────────────────
# Логин администратора. Не оставляйте superadmin/superadmin.
SUPERADMIN_USERNAME=ЗАМЕНИТЕ
SUPERADMIN_PASSWORD=ЗАМЕНИТЕ
# Секрет подписи cookie сессий.
COOKIE_SECRET=ЗАМЕНИТЕ

